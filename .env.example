# Supabase Cloud Database Configuration (24/7 Free Online Database)
# 1. Sign in to https://supabase.com (using your GitHub account)
# 2. Click "New Project" (name it: oufella-books)
# 3. Copy "Project URL" and "anon public key" from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Django Backend URL (for local development or Render)
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000
