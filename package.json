    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@0.21.5": true
